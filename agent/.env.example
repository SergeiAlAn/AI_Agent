# Скопируйте этот файл в .env и укажите свой ключ.
# Ключ ProxyAPI: https://console.proxyapi.ru/keys
PROXIAPI_KEY=your-proxyapi-key

# Необязательные настройки
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
AGENT_MODEL=openai/gpt-5-mini
AGENT_REASONING_EFFORT=low

# Порядок поисковых бэкендов ddgs (backend:region через запятую)
# AGENT_SEARCH_BACKENDS=yahoo:wt-wt,yahoo:ru-ru,duckduckgo:ru-ru,auto:ru-ru
